# Authentication mode:
# - disabled = local development, no Microsoft login required
# - entra    = Microsoft Entra SSO required
AUTH_MODE=disabled

# Local development identity used only when AUTH_MODE=disabled.
DEV_STAFF_ID=local-dev-staff
DEV_STAFF_NAME=Local Developer
DEV_STAFF_EMAIL=local@checkonit.dev

# Auth.js session encryption secret.
# Required when AUTH_MODE=entra. Generate locally with: npx auth secret
AUTH_SECRET=replace-me

# Microsoft Entra ID app registration.
# Required only when AUTH_MODE=entra.
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=

# Dify Service API
# Use the API base URL shown by your published Dify application's Service API page.
# Common self-hosted examples:
# DIFY_BASE_URL=http://localhost/v1
# DIFY_BASE_URL=http://localhost:8080/v1
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=app-your-dify-service-api-key

# Optional when AUTH_MODE=entra: require a company email domain, e.g. educlaas.com
ALLOWED_EMAIL_DOMAIN=
